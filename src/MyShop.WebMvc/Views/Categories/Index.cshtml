@using MyShop.Contracts.Categories
@using MyShop.Contracts.Common

@{
    ViewData["Title"] = "Categories";
    var paged = ViewBag.Page as PaginatedResponse<CategoryResponse>;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Categories</h2>
    <a asp-action="Create" class="btn btn-success">Create New Category</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (paged is not null)
{
    <p>
        Showing page @paged.PageIndex of @paged.TotalPages (Total: @paged.TotalCount items)
    </p>

    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var category in paged.Items)
            {
                <tr>
                    <td>@category.Id</td>
                    <td>@category.Name</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@category.Id" class="btn btn-sm btn-info">Details</a>
                        <a asp-action="Edit" asp-route-id="@category.Id" class="btn btn-sm btn-primary">Edit</a>
                        <a asp-action="Delete" asp-route-id="@category.Id" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (paged.TotalPages > 1)
    {
        <nav>
            <ul class="pagination">
                @for (int i = 1; i <= paged.TotalPages; i++)
                {
                    <li class="page-item @(i == paged.PageIndex ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-pageIndex="@i" asp-route-pageSize="@paged.PageSize">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
}
else
{
    <p>No categories found.</p>
}
